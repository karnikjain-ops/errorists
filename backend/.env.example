# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to .env and supply your private values.
# NEVER commit the real .env file with secrets into version control.
# ==============================================================================

# Google Gemini API key for AI engine complaint classification & deduplication
GEMINI_API_KEY=your_gemini_api_key_here

# Database connection URL (defaults to local SQLite database)
DATABASE_URL=sqlite:///./complaints.db

# Optional server configuration
PORT=8000
HOST=0.0.0.0
