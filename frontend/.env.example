# ==============================================================================
# Frontend Environment Configuration Template
# In Vite, only variables prefixed with VITE_ are exposed to client-side code.
# WARNING: Values here are embedded into client JS and publicly readable!
# NEVER put private API secrets, private tokens, or database passwords here.
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
